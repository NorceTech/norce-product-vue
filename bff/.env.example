# Serve the local JSON files in /mockdata instead of calling Norce. Mock mode is
# only ever entered on purpose: missing credentials are an error, not a fallback
# to the fixtures, because fixtures showing the wrong tenant look like success.
# The fixtures are a capture of Norce Open Demo (application 1042).
#
# run.ps1 sets this to false when a tenant or host is named on the command line
# (-a, -s, -e), since asking for a specific tenant and being served the
# fixtures is never what was meant.
MOCK_DATA=true
LOG_REQUESTS=true

# Credentials do not have to be written here. This file supports variable
# expansion, so it can reference environment variables that already exist on
# your machine, keeping the secrets in your shell or secret manager:
#
#   OAUTH_ID="${MY_NORCE_CLIENT_ID}"
#   OAUTH_SECRET="${MY_NORCE_CLIENT_SECRET}"
#
# Exporting OAUTH_ID / OAUTH_SECRET under those exact names works too, since
# dotenv never overrides variables that are already set.
OAUTH_ID="your_oauth_id"
OAUTH_SECRET="your_oauth_secret"

# Host pattern: <slug>.api-<region>[.<environment>].norce.tech - production has
# no environment segment. `norcecommerce` is the multi-tenant slug and reaches
# most tenants, because APPLICATION_ID below selects the tenant rather than the
# host name does. It works in most places but not all: single-tenant customers
# have their own deployment and have to be named by their own slug.
#
# run.ps1 -s <slug> -e <environment> composes this host for you.
API_BASE="https://norcecommerce.api-se.playground.norce.tech"

# The identity scope follows the environment: playground, prod, and for stage
# either `lab` or `stage` - Norce is renaming that one, so check which your
# credentials expect.
OAUTH_SCOPE="playground"

# APPLICATION_ID and CATEGORY_SEED have no defaults in code - they decide which
# tenant and which part of the catalogue the site shows, and a stale default
# gives an empty storefront instead of an error.
# 1042 = Norce Open Demo, root category 5.
APPLICATION_ID="1042"
CATEGORY_SEED="5"

IDENTITY_PATH="/identity/1.0/connect/token"
PRODUCT_SERVICE="/commerce/product/1.1"
METADATA_SERVICE="/commerce/metadata/1.1"
SHOPPING_SERVICE="/commerce/shopping/1.1"
# --- Checkout (NCO) ---
# NCO_BASE, NCO_MERCHANT, NCO_CHANNEL and NCO_PAYMENT_METHOD_ID have no defaults
# in code: they are tenant-specific, and a hard-coded fallback would silently
# point another tenant at the wrong merchant or payment method. The BFF warns at
# startup if any of them is missing.
# Same host as API_BASE. Splitting them puts Commerce and Checkout in different
# environments, which fails deep in the order flow instead of at startup, so
# run.ps1 -s/-e sets both together.
NCO_BASE="https://norcecommerce.api-se.playground.norce.tech"
NCO_MERCHANT="norce-open-demo"
NCO_CHANNEL="nc-se-nonpsp"
NCO_PAYMENT_METHOD_ID="239"
# Without a delivery method the basket is created without one, which NCO
# initiate may reject. Look the id up for your own application.
NCO_DELIVERY_METHOD_ID=""

# Service paths - rarely need changing
NCO_NORCE_ADAPTER="/checkout/norce-adapter"
NCO_NONPSP_ADAPTER="/checkout/nonpsp-adapter"
NCO_ORDER_API="/checkout/order"
