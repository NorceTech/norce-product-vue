### Get cultures
GET {{api_base}}{{metadata_service}}/GetApplication?format=json&applicationId={{application_id}}&categorySeed={{categories}}&statusSeed=1,3
Content-Type: application/json
Authorization: Bearer {{token}}
applicationId: {{application_id}}

>>! ../mockdata/cultures.json

### Create basket (with NCO payment method)
POST {{api_base}}{{shopping_service}}/CreateBasket?format=json&ipAddress=127.0.0.1&createdBy=1&cultureCode={{culture}}
Content-Type: application/json
Authorization: Bearer {{token}}
applicationId: {{application_id}}

{
  "PaymentMethodId": {{payment_method_id}},
  "Items": [
    {
      "PartNo": "{{productPartNo}}",
      "Name": "{{productName}}",
      "Quantity": 1,
      "PriceListId": {{productPriceListId}}
    }
  ]
}

> {%
    client.global.set('basketId', response.body.Id);
%}

### Get basket
GET {{api_base}}{{shopping_service}}/GetBasket?format=json&cultureCode={{culture}}&id={{basketId}}
Content-Type: application/json
Authorization: Bearer {{token}}
applicationId: {{application_id}}

>>! ../mockdata/basket.json

### Checkout: Create order (NCO Norce adapter)
POST {{nco_base}}{{nco_norce_adapter}}/api/v1/orders
Content-Type: application/json
Authorization: {{nco_auth}}
x-merchant: {{nco_merchant}}
x-channel: {{nco_channel}}

{
  "cartReference": {{basketId}},
  "culture": "{{culture}}",
  "currency": "{{productCurrency}}"
}

> {%
    client.global.set('orderId', response.body.id);
%}

>>! ../mockdata/checkout-initiate.json

### Checkout: Create Non-PSP payment
POST {{nco_base}}{{nco_nonpsp_adapter}}/api/checkout/v1/orders/{{orderId}}/payments
Content-Type: application/json
Authorization: {{nco_auth}}
x-merchant: {{nco_merchant}}
x-channel: {{nco_channel}}

{}

> {%
    client.global.set('paymentId', response.body.paymentId);
%}

>>! ../mockdata/checkout-payment.json

