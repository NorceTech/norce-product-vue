# Copy to .env and adjust if you are not on playground.
#
# Norce serves media per client:
#   https://media.<environment>.cdn-norce.tech/<clientId>/<fileKey>
#
# The client id is not configured here - it comes from GetApplication, so the
# images follow whichever APPLICATION_ID the BFF is pointed at. Only the
# environment is a setting:
#
#   playground:  https://media.playground.cdn-norce.tech
#   stage:       https://media.stage.cdn-norce.tech
#   production:  https://media.cdn-norce.tech
#
# Leave unset for playground.
VITE_MEDIA_CDN_HOST="https://media.playground.cdn-norce.tech"
